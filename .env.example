# ================================
# SkyFrame Platform — Environment Variables
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- QuickBooks Online ---
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REDIRECT_URI=http://localhost:3000/callback
QB_ENVIRONMENT=sandbox
# sandbox: sandbox-quickbooks.api.intuit.com
# production: quickbooks.api.intuit.com

# --- TrackPod ---
TRACKPOD_API_KEY=your_trackpod_api_key
TRACKPOD_BASE_URL=https://api.track-pod.com

# --- Monday.com (Phase 2) ---
# MONDAY_API_KEY=your_monday_api_key
# MONDAY_BOARD_ID=your_board_id

# --- Server ---
PORT=3000
NODE_ENV=development
